# App runtime
NODE_ENV=development
PORT=3000

# PostgreSQL connection used by the API container/application
DB_HOST=todo-postgres
DB_PORT=5432
DB_USER=todo_user
DB_PASSWORD=todo_pass
DB_NAME=todo_db

# Docker Compose stack defaults
NETWORK_NAME=todo-network
DB_CONTAINER=todo-postgres
API_CONTAINER=todo-api
DB_VOLUME=todo-pgdata
API_PORT=3000
ADMINER_CONTAINER=todo-adminer
ADMINER_PORT=8080
